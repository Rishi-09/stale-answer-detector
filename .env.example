# Copy this file to .env and replace the placeholders with your own keys.
# Never commit .env or paste its values into logs, issues, or chat.

# Required for live web verification. Create a key at https://app.tavily.com/
TAVILY_API_KEY=tvly_replace_me

# Required when Bifrost routes requests to OpenAI.
OPENAI_API_KEY=sk_replace_me
