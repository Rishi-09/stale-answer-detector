# Copy this file to .env and replace the placeholders with your own keys.
# Never commit .env or paste its values into logs, issues, or chat.

# Groq API Configuration (Primary LLM Provider)
# Create an API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_me

# Dynamically changeable Groq model (e.g. llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768)
GROQ_MODEL=llama-3.3-70b-versatile

# Required for live web verification. Create a key at https://app.tavily.com/
TAVILY_API_KEY=tvly_replace_me

# Optional: Secondary Provider Keys
OPENAI_API_KEY=
